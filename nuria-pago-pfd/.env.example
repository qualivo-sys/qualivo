# ─────────────────────────────────────────────────────────────
#  Variables de entorno — copiar en Vercel (Settings → Environment Variables)
#  NUNCA subir los valores reales a git. Este fichero solo tiene los NOMBRES.
# ─────────────────────────────────────────────────────────────

# ── Redsys ──────────────────────────────────────────────────
# 'production' = sis.redsys.es (dinero real) · 'sandbox' = sis-t.redsys.es (pruebas)
REDSYS_ENV=production
# Clave SHA-256 de PRODUCCION. Se obtiene del panel real:
#   https://canales.redsys.es/lacaixa → Administracion → Comercio → Detalles → Ver clave
REDSYS_SECRET_KEY=
# FUC / numero de comercio
REDSYS_MERCHANT_CODE=369473541
REDSYS_TERMINAL=1
REDSYS_CURRENCY=978
REDSYS_MERCHANT_NAME=Nuria Roure
# Importe en centimos. 220000 = 2.200,00 €
AMOUNT_CENTS=220000
PRODUCT_DESCRIPTION=Programa Por Fin Duermo (PFD)

# ── ThriveCart ──────────────────────────────────────────────
# API token: ThriveCart → Settings → API & Webhooks → API tokens
THRIVECART_API_TOKEN=
# ID del curso "Por fin duermo" en ThriveCart Learn
THRIVECART_COURSE_ID=
# (Opcional) base de la API y ruta del endpoint de alta, por si hay que ajustarlos
# THRIVECART_API_BASE=https://thrivecart.com/api/external
# THRIVECART_ENROLL_PATH=/learn/access

# ── Sitio ───────────────────────────────────────────────────
# URL publica real del checkout (para las URLs de notificacion y retorno de Redsys)
PUBLIC_BASE_URL=https://pago.nuriaroure.com

# ── Frontend (opcional) ─────────────────────────────────────
NEXT_PUBLIC_PRICE_LABEL=2.200 €
