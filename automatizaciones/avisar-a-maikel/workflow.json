        "method": "POST",
        "url": "={{ $('Config avisos').first().json.ghl_base }}/conversations/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-04-15"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'WhatsApp', contactId: $('Contacto Maikel (GHL)').first().json.contact?.id, message: $('Validar y redactar').first().json.whatsapp }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Qualivo · GHL (Bearer)"
        }
      }
