    {
      "id": "c4000000-0000-4000-8000-000000000007",
      "name": "WhatsApp a Maikel (GHL)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        200
      ],
      "onError": "continueRegularOutput",
