      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "ghl_base",
              "type": "string",
              "value": "https://services.leadconnectorhq.com"
            },
            {
              "id": "a2",
              "name": "ghl_location_id",
              "type": "string",
              "value": "PON-AQUI-LOCATION-ID-DE-QUALIVO"
            },
            {
