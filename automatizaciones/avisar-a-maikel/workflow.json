    {
      "id": "c4000000-0000-4000-8000-000000000003",
      "name": "Validar y redactar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "jsCode": "// Payload: { urgencia: 'rojo'|'normal', titulo, texto, enlace?, agente }\n// Lo llama cualquier agente de Qualivo que necesite a Maikel. Devuelve error legible si falta algo.\nconst entrada = $input.first().json;\nconst b = entrada.body || entrada;\nconst limpiar = (s, max) => String(s ?? '').replace(/\\s+\\n/g, '\\n').trim().slice(0, max);\n\nconst urgencia = String(b.urgencia || 'normal').toLowerCase() === 'rojo' ? 'rojo' : 'normal';\nconst titulo = limpiar(b.titulo, 120);\nconst texto = limpiar(b.texto, 1500);\nconst agente = limpiar(b.agente, 80);\nconst enlace = /^https?:\\/\\/\\S+$/.test(String(b.enlace || '').trim()) ? String(b.enlace).trim() : '';\n\nconst faltan = [!titulo && 'titulo', !texto && 'texto', !agente && 'agente'].filter(Boolean);\nif (faltan.length) {\n  return [{ json: { valido: false, error: `Faltan campos: ${faltan.join(', ')}` } }];\n}\n\nconst marca = urgencia === 'rojo' ? '🔴 URGENTE' : '🟡 Aviso';\nconst whatsapp =\n  `${marca} · ${titulo}\\n\\n${texto}\\n\\n` +\n  (enlace ? `👉 ${enlace}\\n\\n` : '') +\n  `— ${agente}`;\n\nconst esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst asunto = `[${urgencia === 'rojo' ? 'URGENTE' : 'Aviso'}] ${titulo} · ${agente}`;\nconst html =\n  `<p style=\"font-size:15px\"><b>${marca}</b> · ${esc(titulo)}</p>` +\n  `<p style=\"white-space:pre-line\">${esc(texto)}</p>` +\n  (enlace ? `<p><a href=\"${esc(enlace)}\">${esc(enlace)}</a></p>` : '') +\n  `<p style=\"color:#888\">— ${esc(agente)} · enviado por el webhook «Avisar a Maikel»</p>`;\n\nreturn [{ json: { valido: true, urgencia, titulo, agente, enlace, whatsapp, asunto, html } }];\n"
      }
    },
    {
      "id": "c4000000-0000-4000-8000-000000000004",
      "name": "IF válido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
