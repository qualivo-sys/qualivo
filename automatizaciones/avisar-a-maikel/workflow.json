    {
      "id": "c4000000-0000-4000-8000-000000000008",
      "name": "Resumen de envío",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        200
      ],
      "parameters": {
        "jsCode": "// Junta el resultado de los dos canales. Un canal caído no tumba el otro.\nconst email = $('Email a Maikel (Gmail)').first().json;\nconst wa = $('WhatsApp a Maikel (GHL)').first().json;\nconst emailOk = Boolean(email.id) && !email.error;\nconst whatsappOk = Boolean(wa.messageId || wa.conversationId) && !wa.error;\nreturn [{ json: {\n  ok: emailOk || whatsappOk,\n  email: emailOk ? 'enviado' : `fallo: ${JSON.stringify(email.error || email).slice(0, 300)}`,\n  whatsapp: whatsappOk ? 'enviado' : `fallo: ${JSON.stringify(wa.error || wa).slice(0, 300)}`,\n} }];"
      }
    },
    {
      "id": "c4000000-0000-4000-8000-000000000009",
