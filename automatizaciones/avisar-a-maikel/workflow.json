        "operation": "send",
        "sendTo": "={{ $('Config avisos').first().json.maikel_email }}",
        "subject": "={{ $('Validar y redactar').first().json.asunto }}",
        "emailType": "html",
        "message": "={{ $('Validar y redactar').first().json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Qualivo · Gmail maikel@qualivo.io"
        }
      }
    },
    {
      "id": "c4000000-0000-4000-8000-000000000006",
      "name": "Contacto Maikel (GHL)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        200
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config avisos').first().json.ghl_base }}/contacts/upsert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ locationId: $('Config avisos').first().json.ghl_location_id, firstName: 'Maikel', lastName: 'Echevarria', email: $('Config avisos').first().json.maikel_email, phone: $('Config avisos').first().json.maikel_whatsapp, tags: ['interno-avisos-agentes'] }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
