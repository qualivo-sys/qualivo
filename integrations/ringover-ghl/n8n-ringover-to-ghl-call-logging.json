d = String(c.call_id || c.cdr_id || '');\n  if (!id || seenSet.has(id)) continue;\n  newIds.push(id);\n  const dir = String(c.direction || '').toLowerCase();\n  const isIn = dir === 'in' || dir.startsWith('in');\n  let phone = isIn ? (c.from_number || '') : (c.to_number || '');\n  phone = String(phone).trim();\n  if (!phone || phone === 'Unknown') continue;\n  if (!phone.startsWith('+')) phone = '+' + phone.replace(/[^0-9]/g, '');\n  const dur = Number(c.total_duration != null ? c.total_duration : (c.incall_duration || 0)) || 0;\n  let estado = 'Contestada';\n  if (c.voicemail) estado = 'Buzon de voz';\n  else if (c.missed === true || c.is_answered === false) estado = 'Perdida';\n  const u = c.user || {};\n  const agent = u.concat_name || ((u.firstname || '') + ' ' + (u.lastname || '')).trim() || 'Agente';\n  out.push({ json: {\n    call_id: id,\n    direction: isIn ? 'Entrante' : 'Saliente',\n    customer_phone: phone,\n    duration_formatted: Math.floor(dur / 60) + ' min ' + (dur % 60) + ' seg',\n    agent_name: agent,\n    recording_url: c.record || '',\n    call_date: c.start_time || '',\n    status: estado\n  } });\n}\nsd.seenCallIds = seen.concat(newIds).slice(-500);\nreturn out;"}, "id": "poll0001-0000-0000-0000-000000000005", "name": "\u00f0\u0178\u201c\u0160 Normalizar Llamada", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1160, 180]}, {"parameters": {"method": "GET", "url": "=https://services.leadconnectorhq.com/contacts/?locationId=NqtT9FXlZmVKuyA4HDbV&query={{ encodeURIComponent($('\u00f0\u0178\u201c\u0160 Normalizar Llamada').item.json.customer_phone) }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "Bearer <GHL_PRIVATE_TOKEN>"}, {"name": "Version", "value": "2021-07-28"}]}, "options": {}}, "id": "poll0001-0000-0000-0000-000000000007", "name": "\u00f0\u0178\u201d\u017d Buscar Contacto GHL", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1640, 180]}, {"parameters": {