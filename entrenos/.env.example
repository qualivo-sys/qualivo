# ─────────────────────────────────────────────────────────────
#  Variables de entorno — copiar en Vercel (Settings → Environment Variables)
#  Este fichero solo tiene los NOMBRES, nunca los valores reales.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (opcional pero recomendado) ───────────────
# Vercel → Storage → Create Database → Neon (Postgres). Al conectarla al
# proyecto, Vercel inyecta DATABASE_URL automaticamente y no hay que tocar nada.
# Sin esta variable la app funciona igual, pero guarda los datos solo en el
# navegador (localStorage), sin sincronizar entre movil y ordenador.
DATABASE_URL=
# Alternativa para bases antiguas de Vercel Postgres (se usa si no hay DATABASE_URL).
POSTGRES_URL=

# ── Codigo de acceso (opcional) ─────────────────────────────
# Si lo defines, la app pide este codigo antes de entrar (son datos de salud
# en una URL publica). Si lo dejas vacio, la app queda abierta.
APP_PASSCODE=

# ── Perfiles (opcional) ─────────────────────────────────────
# Formato: id:Nombre separados por coma. Por defecto: maikel:Maikel,isa:Isa
NEXT_PUBLIC_PERFILES=maikel:Maikel,isa:Isa
