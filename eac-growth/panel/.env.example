# EAC · panel comercial — variables de entorno de Vercel.
# NINGÚN valor real vive en el repo. Rellenar en Vercel → Settings → Environment Variables.

# --- CRM (obligatorio: sin esto el panel no arranca) ---
GHL_TOKEN=            # Private Integration Token de GoHighLevel
GHL_LOCATION_ID=      # 5Eylu2xUj1SoQaQnfmF8 en EAC
GHL_PIPELINE_ID=      # szo4sahi0aXi67KORRTq · si se omite, mezcla todos los pipelines
DASHBOARD_PASSWORD=   # contraseña compartida del panel

# --- Meta Ads ---
META_TOKEN=
META_ACT=act_10151404080652508
META_API_VERSION=v21.0

# --- Google Ads (EAC va por OAuth: la cuenta de servicio da NOT_ADS_USER) ---
GADS_DEV_TOKEN=
GADS_CUSTOMER_ID=8699549656
GADS_LOGIN_CUSTOMER_ID=9812988446   # el MCC
GADS_API_VERSION=v22
GADS_CLIENT_ID=
GADS_CLIENT_SECRET=
GADS_REFRESH_TOKEN=   # scopes: adwords + webmasters.readonly

# --- SEO y analítica ---
GSC_DOMAIN=escolaeronauticadecatalunya.cat   # sin el prefijo sc-domain:
GA4_PROPERTY_ID=553107941
GOOGLE_SA_B64=        # base64 -w0 sa.json · solo para GA4; GSC va por OAuth

# --- TikTok: sin API aprobada, cifra manual. `days` acota el reparto a los días con datos ---
TIKTOK_INV={"2026-09":{"spend":138.02,"leads":11,"days":8}}

# --- Ventana del panel ---
PANEL_DESDE=2026-05-01
