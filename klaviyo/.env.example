# Copia este fichero a  klaviyo/.env  y rellena tu clave privada de Klaviyo.
# .env está en .gitignore: NUNCA se sube al repositorio.

# Clave privada (Settings -> API keys). Empieza por "pk_". Da acceso de lectura/escritura.
KLAVIYO_API_KEY=pk_pon_aqui_tu_clave_privada

# Revisión de la API. La exportación de definiciones de flow requiere 2025-01-15 o superior.
KLAVIYO_API_REVISION=2025-07-15
