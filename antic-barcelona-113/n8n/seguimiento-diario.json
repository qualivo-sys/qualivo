{
  "name": "Antic Barcelona 113 · Seguimiento diario",
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "reloj",
      "name": "Cada día a las 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-160, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 10 * * *" }] } }
    },
    {
      "id": "llamar",
      "name": "Mirar a quién le toca",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 0],
      "parameters": {
        "url": "https://antic-barcelona-113.vercel.app/api/seguimiento",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 60000, "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PENDIENTE", "name": "AB113 · cabecera del webhook de leads" }
      }
    },
    {
      "id": "juzgar",
      "name": "¿Fue bien?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 0],
      "parameters": {
        "jsCode": "// Un seguimiento que deja de funcionar no se nota: no hay error visible,\n// simplemente los leads dejan de recibir nada. Por eso se avisa si falla.\nconst r = $input.first().json;\nconst cuerpo = r.body || {};\nconst mal = r.statusCode !== 200 || cuerpo.ok !== true;\nreturn [{ json: {\n  mal,\n  enviados: cuerpo.enviados || 0,\n  detalle: mal ? `HTTP ${r.statusCode} · ${JSON.stringify(cuerpo).slice(0, 200)}` : '',\n} }];"
      }
    },
    {
      "id": "sifalla",
      "name": "¿Hay que avisar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [{ "id": "f1", "leftValue": "={{ $json.mal }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "avisar",
      "name": "Avisar del fallo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [740, -60],
      "parameters": {
        "fromEmail": "info@maikelechevarria.com",
        "toEmail": "info@maikelechevarria.com",
        "subject": "=⚠️ El seguimiento de leads de Antic Barcelona 113 ha fallado",
        "html": "=<div style=\"font-family:system-ui,sans-serif;font-size:15px;color:#332B23\"><p>Los leads que se quedaron en la guía no han recibido su recordatorio hoy.</p><p style=\"background:#FCE8E6;padding:10px 14px;border-radius:6px\">{{ $json.detalle }}</p></div>",
        "options": {}
      },
      "credentials": {
        "smtp": { "id": "PENDIENTE", "name": "SMTP Gmail · info@maikelechevarria.com" }
      }
    }
  ],
  "connections": {
    "Cada día a las 10:00": { "main": [[{ "node": "Mirar a quién le toca", "type": "main", "index": 0 }]] },
    "Mirar a quién le toca": { "main": [[{ "node": "¿Fue bien?", "type": "main", "index": 0 }]] },
    "¿Fue bien?": { "main": [[{ "node": "¿Hay que avisar?", "type": "main", "index": 0 }]] },
    "¿Hay que avisar?": { "main": [[{ "node": "Avisar del fallo", "type": "main", "index": 0 }], []] }
  }
}
