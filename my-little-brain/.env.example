# ─────────────────────────────────────────────────────────────
#  Variables de entorno — copiar en Vercel (Settings → Environment Variables).
#  Este fichero solo tiene los NOMBRES, nunca los valores reales.
# ─────────────────────────────────────────────────────────────

# ── Supabase (obligatorio) ──────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Se salta RLS: la usan el webhook de Stripe y la tarea del domingo.
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude (el coach) ───────────────────────────────────────
# console.anthropic.com → API keys. Sin ella la app funciona,
# pero el chat avisa de que falta configurarla.
ANTHROPIC_API_KEY=
# Modelo del chat. Por defecto claude-opus-5 ($5/$25 por millon de tokens).
# claude-sonnet-5 ($2/$10) da muy buen resultado en el coach por menos de la mitad.
ANTHROPIC_MODEL=claude-sonnet-5
# Modelo de la revision semanal (una llamada por semana; merece el mejor).
ANTHROPIC_MODEL_REVISION=claude-opus-5
# Solo si tu clave es "vinculada a identidad" (la API pide anthropic-workspace-id):
# Console → Settings → Workspaces → el id wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# ── Stripe (opcional: si no esta, la app no ofrece pagar) ───
STRIPE_SECRET_KEY=
# ID del precio recurrente del plan Pro (price_...)
STRIPE_PRICE_PRO=
# Stripe → Developers → Webhooks → endpoint /api/pago/webhook
STRIPE_WEBHOOK_SECRET=

# ── Sitio ───────────────────────────────────────────────────
# URL publica real (para las vueltas de Stripe). En Vercel se deduce sola.
NEXT_PUBLIC_SITE_URL=

# ── Tarea programada (revision de los domingos) ─────────────
# Cualquier cadena larga y aleatoria. Vercel la manda como Bearer.
CRON_SECRET=

# ── Textos legales ──────────────────────────────────────────
# Responsable del tratamiento. Mientras falten, /legal muestra un aviso.
NEXT_PUBLIC_LEGAL_EMPRESA=
NEXT_PUBLIC_LEGAL_CIF=
NEXT_PUBLIC_LEGAL_DIRECCION=
NEXT_PUBLIC_LEGAL_EMAIL=

# ── Avisos push (Web Push / VAPID) ──────────────────────────
# Generar una vez: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com
